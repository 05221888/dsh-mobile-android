{
    "name":  "@wushenghuang/dsh-memory-sync-hub",
    "version":  "0.2.0",
    "description":  "Cross-device DSH memory sync + peer mailbox poll: Gitee private repo relay for memories, plus a timer that auto-wakes a dedicated session only when there is unread task mail. Empty inbox never calls the model.",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./merge":  "./lib/merge.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "scripts",
                  "tests",
                  "README.md",
                  "LICENSE",
                  "cordis.patch.yml"
              ],
    "dsh": {
        "runtime": "host",
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "license":  "MIT",
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "memory",
                     "sync",
                     "gitee",
                     "mobile"
                 ]
}
