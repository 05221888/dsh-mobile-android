{
  "name": "@dsh-external/dsh-model-failover",
  "version": "0.0.1",
  "description": "LLM 模型请求失败时自动按配置的 fallback 链切换到备选 provider/model 继续任务",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "BSD-3-Clause",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
