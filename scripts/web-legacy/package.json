{
  "name": "dsh-mobile-web-legacy",
  "private": true,
  "type": "module",
  "description": "Downlevel dsh front-end bundles to Chromium 83 syntax (Android 10 MIUI stock WebView). See gen_legacy.mjs.",
  "scripts": {
